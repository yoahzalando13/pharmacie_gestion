digraph MLD {
graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, label="PharmaGest — Modèle logique de données (MLD)\n ", nodesep=0.35, ranksep=1.1, splines=true, bgcolor="white", pad=0.4];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [color="#64748b", arrowhead=crow, arrowtail=none, dir=forward, penwidth=1.1];
"utilisateurs_utilisateur" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#e0f2fe" colspan="2" align="center"><b>utilisateurs_utilisateur</b></td></tr><tr><td align="left" port="id"><u><b>id</b></u></td><td align="left"><font color="#64748b">BIGINT</font></td></tr><tr><td align="left" port="username">username</td><td align="left"><font color="#64748b">VARCHAR(150)</font></td></tr><tr><td align="left" port="first_name">first_name</td><td align="left"><font color="#64748b">VARCHAR(150)</font></td></tr><tr><td align="left" port="last_name">last_name</td><td align="left"><font color="#64748b">VARCHAR(150)</font></td></tr><tr><td align="left" port="email">email</td><td align="left"><font color="#64748b">VARCHAR(254)</font></td></tr><tr><td align="left" port="is_active">is_active</td><td align="left"><font color="#64748b">BOOLEAN</font></td></tr><tr><td align="left" port="telephone">telephone</td><td align="left"><font color="#64748b">VARCHAR(20)</font></td></tr><tr><td align="left" colspan="2"><font color="#64748b">… password, is_staff, is_superuser, date_joined</font></td></tr></table>>];
