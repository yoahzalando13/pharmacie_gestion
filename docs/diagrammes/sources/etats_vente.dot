digraph E {
graph [rankdir=LR, fontname="Helvetica", fontsize=18, labelloc=t, label="Diagramme d'états — Vente et paiement\n ", nodesep=0.6, ranksep=1.3, bgcolor="white", pad=0.4];
node [shape=box, style="rounded,filled", fillcolor="#f0fdf4", color="#15803d", fontname="Helvetica", fontsize=13, penwidth=1.4];
edge [fontname="Helvetica", fontsize=11, color="#334155"];
subgraph cluster_v { label="Vente"; style="rounded"; color="#94a3b8"; fontsize=14;
  v0 [shape=circle, width=0.25, label="", style=filled, fillcolor="#0f172a"];
  vf [shape=doublecircle, width=0.2, label="", style=filled, fillcolor="#0f172a"];
  VALIDEE [label="VALIDÉE"]; ANNULEE [label="ANNULÉE", fillcolor="#fef2f2", color="#b91c1c"];
  v0 -> VALIDEE [label="confirmer en caisse"];
  VALIDEE -> VALIDEE [label="retour partiel\n(compensatoire)"];
  VALIDEE -> ANNULEE [label="annuler\n[aucun retour, motif]"];
  ANNULEE -> vf;
}
subgraph cluster_p { label="Paiement"; style="rounded"; color="#94a3b8"; fontsize=14;
  p0 [shape=circle, width=0.25, label="", style=filled, fillcolor="#0f172a"];
  ATT [label="EN ATTENTE", fillcolor="#fffbeb", color="#d97706"]; CONF [label="CONFIRMÉ"]; REJ [label="REJETÉ", fillcolor="#fef2f2", color="#b91c1c"];
  p0 -> CONF [label="espèces"];
  p0 -> ATT [label="mobile money,\ncarte, chèque"];
  ATT -> CONF [label="vérifier\n[référence saisie]"];
  ATT -> REJ [label="rejeter"];
}
}
