graph MCD {
graph [layout=neato, overlap=prism, overlap_scaling=-6, sep="+18", splines=true, fontname="Helvetica", fontsize=22, labelloc=t, label="PharmaGest — Modèle conceptuel de données (MCD, Merise)\n ", bgcolor="white", pad=0.5];
node [fontname="Helvetica", fontsize=13];
edge [color="#475569", fontname="Helvetica", fontsize=14, fontcolor="#b91c1c", penwidth=1.2, len=1.6];
"UTILISATEUR" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#e0f2fe"><b>UTILISATEUR</b></td></tr><tr><td align="left" balign="left"><u><b>id_utilisateur</b></u><br/>identifiant (username)<br/>nom<br/>prénom<br/>email<br/>téléphone<br/>actif</td></tr></table>>];
"RÔLE" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#e0f2fe"><b>RÔLE</b></td></tr><tr><td align="left" balign="left"><u><b>id_role</b></u><br/>nom</td></tr></table>>];
"JOURNAL_AUDIT" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#e0f2fe"><b>JOURNAL_AUDIT</b></td></tr><tr><td align="left" balign="left"><u><b>id_journal</b></u><br/>action<br/>objet<br/>détails<br/>date</td></tr></table>>];
"CATÉGORIE" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#dcfce7"><b>CATÉGORIE</b></td></tr><tr><td align="left" balign="left"><u><b>id_categorie</b></u><br/>nom<br/>description</td></tr></table>>];
"MÉDICAMENT" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#dcfce7"><b>MÉDICAMENT</b></td></tr><tr><td align="left" balign="left"><u><b>id_medicament</b></u><br/>nom<br/>dci<br/>forme<br/>dosage<br/>laboratoire<br/>code_barres<br/>photo<br/>prix_achat<br/>prix_vente<br/>seuil_alerte<br/>statut</td></tr></table>>];
"FOURNISSEUR" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#fef3c7"><b>FOURNISSEUR</b></td></tr><tr><td align="left" balign="left"><u><b>id_fournisseur</b></u><br/>nom<br/>adresse<br/>téléphone<br/>email<br/>numéro_fiscal<br/>contact_principal<br/>actif</td></tr></table>>];
"CLIENT" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#fce7f3"><b>CLIENT</b></td></tr><tr><td align="left" balign="left"><u><b>id_client</b></u><br/>nom<br/>téléphone<br/>adresse<br/>email<br/>actif</td></tr></table>>];
"COMMANDE_ACHAT" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#ffedd5"><b>COMMANDE_ACHAT</b></td></tr><tr><td align="left" balign="left"><u><b>id_commande</b></u><br/>numéro<br/>statut<br/>note<br/>date_création<br/>date_validation<br/>date_annulation</td></tr></table>>];
"RÉCEPTION" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#ffedd5"><b>RÉCEPTION</b></td></tr><tr><td align="left" balign="left"><u><b>id_reception</b></u><br/>numéro<br/>date_réception<br/>note</td></tr></table>>];
"LOT" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#ede9fe"><b>LOT</b></td></tr><tr><td align="left" balign="left"><u><b>id_lot</b></u><br/>numéro_lot<br/>date_péremption<br/>quantité_reçue<br/>quantité<br/>bloqué<br/>motif_blocage</td></tr></table>>];
"MOUVEMENT_STOCK" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#ede9fe"><b>MOUVEMENT_STOCK</b></td></tr><tr><td align="left" balign="left"><u><b>id_mouvement</b></u><br/>type<br/>quantité<br/>stock_avant<br/>stock_après<br/>référence<br/>motif<br/>date</td></tr></table>>];
"VENTE" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#fee2e2"><b>VENTE</b></td></tr><tr><td align="left" balign="left"><u><b>id_vente</b></u><br/>numéro<br/>statut<br/>total<br/>date<br/>date_annulation<br/>motif_annulation</td></tr></table>>];
"LIGNE_VENTE" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#fee2e2"><b>LIGNE_VENTE</b></td></tr><tr><td align="left" balign="left"><u><b>id_ligne_vente</b></u><br/>quantité<br/>prix_unitaire<br/>coût_unitaire</td></tr></table>>];
"PAIEMENT" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#fee2e2"><b>PAIEMENT</b></td></tr><tr><td align="left" balign="left"><u><b>id_paiement</b></u><br/>mode<br/>montant<br/>montant_reçu<br/>référence<br/>statut<br/>date<br/>date_vérification</td></tr></table>>];
"RETOUR_VENTE" [shape=plain, label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" style="rounded"><tr><td bgcolor="#fee2e2"><b>RETOUR_VENTE</b></td></tr><tr><td align="left" balign="left"><u><b>id_retour</b></u><br/>numéro<br/>quantité<br/>motif<br/>remis_en_stock<br/>montant_remboursé<br/>mode_remboursement<br/>date</td></tr></table>>];
"a0" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>POSSÉDER</b>>];
"UTILISATEUR" -- "a0" [label=" 0,n "];
"RÔLE" -- "a0" [label=" 0,n "];
"a1" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>TRACER</b>>];
"JOURNAL_AUDIT" -- "a1" [label=" 0,1 "];
"UTILISATEUR" -- "a1" [label=" 0,n "];
"a2" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>APPARTENIR</b>>];
"MÉDICAMENT" -- "a2" [label=" 1,1 "];
"CATÉGORIE" -- "a2" [label=" 0,n "];
"a3" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>RELEVER_DE</b>>];
"LOT" -- "a3" [label=" 1,1 "];
"MÉDICAMENT" -- "a3" [label=" 0,n "];
"a4" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>ADRESSER</b>>];
"COMMANDE_ACHAT" -- "a4" [label=" 1,1 "];
"FOURNISSEUR" -- "a4" [label=" 0,n "];
"a5" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>CONTENIR</b><br/><font point-size='10' color='#334155'>quantité_commandée<br/>prix_achat<br/>quantité_reçue</font>>];
"COMMANDE_ACHAT" -- "a5" [label=" 1,n "];
"MÉDICAMENT" -- "a5" [label=" 0,n "];
"a6" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>CORRESPONDRE</b>>];
"RÉCEPTION" -- "a6" [label=" 1,1 "];
"COMMANDE_ACHAT" -- "a6" [label=" 0,n "];
"a7" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>LIVRER</b><br/><font point-size='10' color='#334155'>quantité<br/>prix_achat</font>>];
"RÉCEPTION" -- "a7" [label=" 1,n "];
"LOT" -- "a7" [label=" 0,n "];
"a8" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>AFFECTER</b>>];
"MOUVEMENT_STOCK" -- "a8" [label=" 1,1 "];
"LOT" -- "a8" [label=" 0,n "];
"a9" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>EFFECTUER</b>>];
"MOUVEMENT_STOCK" -- "a9" [label=" 1,1 "];
"UTILISATEUR" -- "a9" [label=" 0,n "];
"a10" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>RÉALISER</b>>];
"VENTE" -- "a10" [label=" 1,1 "];
"UTILISATEUR" -- "a10" [label=" 0,n "];
"a11" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>ACHETER</b>>];
"VENTE" -- "a11" [label=" 0,1 "];
"CLIENT" -- "a11" [label=" 0,n "];
"a12" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>COMPOSER</b>>];
"LIGNE_VENTE" -- "a12" [label=" 1,1 "];
"VENTE" -- "a12" [label=" 1,n "];
"a13" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>PRÉLEVER</b>>];
"LIGNE_VENTE" -- "a13" [label=" 1,1 "];
"LOT" -- "a13" [label=" 0,n "];
"a14" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>RÉGLER</b>>];
"PAIEMENT" -- "a14" [label=" 1,1 "];
"VENTE" -- "a14" [label=" 1,n "];
"a15" [shape=ellipse, style=filled, fillcolor="#f8fafc", color="#334155", label=<<b>PORTER_SUR</b>>];
"RETOUR_VENTE" -- "a15" [label=" 1,1 "];
"LIGNE_VENTE" -- "a15" [label=" 0,n "];
}