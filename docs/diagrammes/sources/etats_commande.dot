digraph E {
graph [rankdir=LR, fontname="Helvetica", fontsize=18, labelloc=t, label="Diagramme d'états — Commande d'achat\n ", nodesep=0.7, ranksep=1.3, bgcolor="white", pad=0.4];
node [shape=box, style="rounded,filled", fillcolor="#f0fdf4", color="#15803d", fontname="Helvetica", fontsize=13, penwidth=1.4];
edge [fontname="Helvetica", fontsize=11, color="#334155", fontcolor="#0f172a"];
debut [shape=circle, width=0.25, label="", style=filled, fillcolor="#0f172a"];
fin [shape=doublecircle, width=0.2, label="", style=filled, fillcolor="#0f172a"];
BROUILLON; COMMANDEE [label="COMMANDÉE"]; PARTIELLE [label="PARTIELLEMENT\nREÇUE"]; RECUE [label="ENTIÈREMENT\nREÇUE"]; ANNULEE [label="ANNULÉE", fillcolor="#fef2f2", color="#b91c1c"];
debut -> BROUILLON [label="créer"];
BROUILLON -> BROUILLON [label="ajouter / retirer\nune ligne"];
BROUILLON -> COMMANDEE [label="valider\n[≥ 1 ligne]"];
BROUILLON -> ANNULEE [label="annuler"];
COMMANDEE -> ANNULEE [label="annuler\n[rien reçu]"];
COMMANDEE -> PARTIELLE [label="réceptionner\n[reste à recevoir]"];
COMMANDEE -> RECUE [label="réceptionner\n[tout reçu]"];
PARTIELLE -> PARTIELLE [label="réceptionner\n[reste à recevoir]"];
PARTIELLE -> RECUE [label="réceptionner\n[tout reçu]"];
RECUE -> fin; ANNULEE -> fin;
}
